{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meld.dev/schemas/trace-customization.v1.json",
  "title": "Meld interface customization",
  "description": "A presentation-only recipe. It cannot add code, capabilities, URLs, or data mutations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "density",
    "accent",
    "lens",
    "sourceSort",
    "inspector",
    "surfaceTitle",
    "rationale",
    "guidance"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "mode": { "type": "string", "enum": ["read", "synthesize", "brief"] },
    "density": { "type": "string", "enum": ["compact", "balanced", "spacious"] },
    "accent": { "type": "string", "enum": ["ember", "ocean", "jade", "violet"] },
    "lens": { "type": "string", "enum": ["all", "included", "challenges", "high-confidence"] },
    "sourceSort": { "type": "string", "enum": ["workspace", "year-desc", "year-asc", "title"] },
    "inspector": { "type": "boolean" },
    "surfaceTitle": { "type": "string", "minLength": 1, "maxLength": 72 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 360 },
    "guidance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 140 }
    }
  }
}
